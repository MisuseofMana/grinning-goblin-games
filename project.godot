; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="merge-test-game"
run/main_scene="res://scenes/battle-scene.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

Utilities="*res://globals/Utilities.gd"
SaveData="*res://globals/save_data.tscn"
StatMods="*res://globals/stat_modifiers.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/dpi/allow_hidpi=false
mouse_cursor/custom_image="res://art/ui/cursor.png"
window/canvas_textures/default_texture_filter=0

[file_customization]

folder_colors={
"res://art/": "yellow",
"res://audio/": "pink",
"res://components/battleUnits/": "green",
"res://components/cardUI/": "teal",
"res://components/cards/": "red",
"res://components/deckManagement/": "gray",
"res://components/tokens/": "purple",
"res://icons/": "gray",
"res://scenes/": "teal"
}

[global_group]

card_markers="card markers for discard and deck shuffle"
SaveNodes="all save nodes have a saveData function to call when saving the game"
action_point_node=""
battle_unit=""

[gui]

timers/tooltip_delay_sec=0.01
theme/custom_font="res://fonts/m5x7.ttf"
theme/default_font_antialiasing=0

[layer_names]

2d_physics/layer_1="Unit Card Collision"
2d_physics/layer_2="Mouse Events"

[rendering]

textures/canvas_textures/default_texture_filter=0
